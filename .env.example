# Base 链 RPC
RPC_HTTP_URL=https://lb.drpc.org/ogrpc?network=base&dkey=YOUR_KEY
RPC_HTTP_URL_FALLBACK=https://base-mainnet.core.chainstack.com/YOUR_KEY

# 执行钱包
PRIVATE_KEY=0xyour_private_key_here
WALLET_ADDRESS=0xyour_wallet_address_here

# OKX API（同一组 Key 同时用于 DEX v6 和 CEX v5）
OKX_API_KEY=your_okx_api_key
OKX_SECRET_KEY=your_okx_secret_key
OKX_PASSPHRASE=your_okx_passphrase
# 如需合约交易，请确保 API Key 有 Trade 权限且绑定了 API 交易密码
